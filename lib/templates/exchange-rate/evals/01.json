{
 "name": "Crossing above notifies",
 "trigger": {
  "type": "interval"
 },
 "settings": {
  "from": "USD",
  "to": "INR",
  "above": 84
 },
 "http": {
  "https://open.er-api.com/v6/latest/*": "{\"rates\":{\"INR\":84.31}}"
 },
 "expect": {
  "notify": {
   "count": 1,
   "titleIncludes": [
    "above 84"
   ],
   "bodyIncludes": [
    "84.31"
   ]
  }
 }
}
