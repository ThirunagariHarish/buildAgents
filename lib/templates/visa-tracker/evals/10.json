p;</td>\n<td valign=\"top\">01JAN18&nbsp;</td>\n<td valign=\"top\">01SEP14&nbsp;</td>\n<td valign=\"top\">01JUL21&nbsp;</td>\n<td valign=\"top\">01JUL21&nbsp;</td>\n</tr>\n<tr>\n<td valign=\"top\">4th</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n</tr>\n<tr>\n<td valign=\"top\">Certain Religious Workers</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n<td valign=\"top\">15MAR21&nbsp;</td>\n</tr>\n<tr>\n<td valign=\"top\">5th Unreserved<br>\n(including C5, T5, I5, R5, NU, RU)</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">01OCT16&nbsp;</td>\n<td valign=\"top\">01APR22&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n</tr>\n<tr>\n<td valign=\"top\">5th Set Aside:<br>\nRural (20%, including NR, RR)</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n</tr>\n<tr>\n<td valign=\"top\">5th Set Aside:<br>\nHigh Unemployment (10%, including NH, RH)</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n</tr>\n<tr>\n<td valign=\"top\">5th Set Aside:<br>\nInfrastructure (2%, including RI)</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n<td valign=\"top\">C&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p><b>C.&nbsp; THE DIVERSITY (DV) IMMIGRANT VISA CATEGORY</b></p>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\"><tbody>\n<tr><td><b>Region</b></td><td><b>All DV Chargeability Areas Except Those Listed Separately</b></td><td>&nbsp;</td></tr>\n<tr><td>AFRICA